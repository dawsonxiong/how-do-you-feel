// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  apiToken      String?   @unique // For iOS Shortcuts integration
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  moodEntries       MoodEntry[]
  sharingMoodWith   MoodShare[] @relation("SharingMoodFrom") // Users I'm sharing my mood with
  viewingMoodFrom   MoodShare[] @relation("SharingMoodTo")   // Users whose mood I can view

  @@map("users")
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String   // Add user relationship
  rating    Float    // 0-10 scale
  date      DateTime // Date of the entry (without time for daily grouping)
  tags      String?  // Optional comma-separated tags
  notes     String?  // Optional notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("mood_entries")
}

model MoodShare {
  id         String   @id @default(cuid())
  fromUserId String   // User sharing their mood data
  toUserId   String   // User who can view the mood data
  createdAt  DateTime @default(now())

  fromUser User @relation("SharingMoodFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("SharingMoodTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@map("mood_shares")
}
